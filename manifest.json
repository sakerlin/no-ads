{
  "manifest_version": 3,
  "name": "no ads",
  "version": "0.1.0",
  "description": "Lightweight ad blocker: hide common ad DOM blocks + optional request blocking.",
  "permissions": ["storage", "declarativeNetRequest", "declarativeNetRequestFeedback", "tabs"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "no ads"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rulesets/ruleset_1.json"
      }
    ]
  }
}
